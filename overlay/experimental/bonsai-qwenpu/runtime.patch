+void llama_context::qwenpu_load(const char * path) {
+    synchronize();
+    qwenpu = std::make_unique<llama_qwenpu_circuit>(backend_cpu, path);
+}
+
+void llama_context::qwenpu_reset(const char * path) {
+    if (!qwenpu) {
+        throw std::runtime_error("QwenPU graph is not loaded");
+    }
+    qwenpu->reset(path);
+}
+
+void llama_context::qwenpu_reset_program(uint32_t program) {
+    if (!qwenpu) {
+        throw std::runtime_error("QwenPU graph is not loaded");
+    }
+    qwenpu->reset_program(program);
+}
+
+llama_qwenpu_tokens llama_context::qwenpu_tokens() const {
+    if (!qwenpu) {
+        throw std::runtime_error("QwenPU graph is not loaded");
+    }
+    return qwenpu->tokens();
+}
+
+int32_t llama_context::qwenpu_step(int32_t token) {
+    if (!qwenpu) {
+        throw std::runtime_error("QwenPU fixture is not loaded");
+    }
+    return qwenpu->step(token);
+}
+
+int32_t llama_qwenpu_load(llama_context * ctx, const char * path) {
+    if (!ctx || !path) {
+        return -1;
+    }
+    try {
+        ctx->qwenpu_load(path);
+        return 0;
+    } catch (const std::exception & e) {
+        LLAMA_LOG_ERROR("%s: %s\n", __func__, e.what());
+        return -1;
+    }
+}
+
+int32_t llama_qwenpu_reset(llama_context * ctx, const char * path) {
+    if (!ctx || !path) {
+        return -1;
+    }
+    try {
+        ctx->qwenpu_reset(path);
+        return 0;
+    } catch (const std::exception & e) {
+        LLAMA_LOG_ERROR("%s: %s\n", __func__, e.what());
+        return -1;
+    }
+}
+
+int32_t llama_qwenpu_reset_program(llama_context * ctx, uint32_t program) {
+    if (!ctx) {
+        return -1;
+    }
+    try {
+        ctx->qwenpu_reset_program(program);
+        return 0;
+    } catch (const std::exception & e) {
+        LLAMA_LOG_ERROR("%s: %s\n", __func__, e.what());
+        return -1;
+    }
+}
+
+int32_t llama_qwenpu_get_tokens(llama_context * ctx, llama_qwenpu_tokens * tokens) {
+    if (!ctx || !tokens) {
+        return -1;
+    }
+    try {
+        *tokens = ctx->qwenpu_tokens();
+        return 0;
+    } catch (const std::exception & e) {
+        LLAMA_LOG_ERROR("%s: %s\n", __func__, e.what());
+        return -1;
+    }
+}
+
+int32_t llama_qwenpu_step(llama_context * ctx, int32_t token, int32_t * prediction) {
+    if (!ctx || token < 0 || !prediction) {
+        return -1;
+    }
+    try {
+        *prediction = ctx->qwenpu_step(token);
+        return 0;
+    } catch (const std::exception & e) {
+        LLAMA_LOG_ERROR("%s: %s\n", __func__, e.what());
+        return -1;
+    }
+}
